generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["metrics", "postgresqlExtensions", "multiSchema", "relationJoins", "strictUndefinedChecks"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
  schemas    = ["telegram", "public"]
}

/**
 * ______________________________________ [TELEGRAM] ______________________________________
 */

model TelegramBot {
  id                      String     @id @default(uuid()) @db.Uuid
  token                   String
  name                    String     @db.VarChar(255)
  firstName               String?    @map("first_name")
  username                String?
  isEnabled               Boolean    @default(true)
  status                  BOT_STATUS @default(OFFLINE)
  lastUsedAt              DateTime?
  canJoinGroups           Boolean?   @default(true) @map("can_join_groups")
  canReadAllGroupMessages Boolean?   @default(true) @map("can_read_all_group_messages")
  supportsInlineQueries   Boolean?   @default(false) @map("supports_inline_queries")
  companyId               String     @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase?
  messages      TelegramMessage[]
  allowedUsers  TelegramAllowedUser[]
  users         TelegramUser[]

  @@unique([token, companyId])
  @@unique([name, companyId])
  @@index([companyId])
  @@map("bots")
  @@schema("telegram")
}

enum BOT_STATUS {
  ONLINE
  OFFLINE

  @@schema("telegram")
}

model TelegramUser {
  id           String  @id @default(uuid()) @db.Uuid
  telegramId   BigInt  @unique @map("telegram_id")
  firstName    String  @map("first_name")
  lastName     String? @map("last_name")
  username     String?
  languageCode String? @map("language_code")
  isBot        Boolean @default(false) @map("is_bot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages TelegramMessage[]
  bots     TelegramBot[]

  @@map("users")
  @@schema("telegram")
}

model TelegramMessage {
  id     String       @id @default(uuid()) @db.Uuid
  text   String
  role   MESSAGE_ROLE
  botId  String       @map("bot_id") @db.Uuid
  userId String       @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user TelegramUser @relation(fields: [userId], references: [id])
  bot  TelegramBot  @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([userId])
  @@map("messages")
  @@schema("telegram")
}

model TelegramAllowedUser {
  id        String   @id @default(uuid()) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  username  String 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, username]) 
  @@index([botId])
  @@index([username])
  @@map("allowed_users")
  @@schema("telegram")
}

/**
 * ______________________________________________________________________________________
 * ______________________________________________________________________________________
 */

/**
 * ______________________________________ [PUBLIC] ______________________________________
 */

model Embeddings {
  id         String                 @id @default(uuid())
  content    String
  metadata   Json                   @db.JsonB
  embeddings Unsupported("vector")?
  checksum   String
  fileId     String?                @map("file_id")
  file       File?                  @relation("FileEmbeddings", fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  @@map("embeddings")
  @@schema("public")
}

enum FILE_STATUS {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("public")
}

model File {
  id         String      @id @default(uuid())
  name       String
  mimeType   String      @map("mime_type")
  size       Int
  storageKey String      @map("storage_key")
  status     FILE_STATUS @default(PENDING)
  companyId  String      @map("company_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  knowledgeBases KnowledgeBaseFile[]
  embeddings     Embeddings[]        @relation("FileEmbeddings")

  @@index([companyId])
  @@map("files")
  @@schema("public")
}

model KnowledgeBase {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  botId     String?  @unique @map("bot_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  files KnowledgeBaseFile[]
  chats Chat[]
  bot   TelegramBot?        @relation(fields: [botId], references: [id])

  @@unique([name, companyId])
  @@index([companyId])
  @@map("knowledge_bases")
  @@schema("public")
}

model KnowledgeBaseFile {
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid
  fileId          String   @map("file_id")
  createdAt       DateTime @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  file          File          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([knowledgeBaseId, fileId])
  @@map("knowledge_base_files")
  @@schema("public")
}

model Chat {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @default("New Chat")
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  messages      ChatMessage[]
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@map("chats")
  @@schema("public")
}

model ChatMessage {
  id        String       @id @default(uuid()) @db.Uuid
  text      String
  role      MESSAGE_ROLE
  chatId    String       @map("chat_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
  @@schema("public")
}

enum MESSAGE_ROLE {
  USER
  ASSISTANT

  @@schema("public")
}

